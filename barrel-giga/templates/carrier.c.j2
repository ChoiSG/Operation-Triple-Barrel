SG_IMPORT int WINAPI MessageBoxW(HWND, const wchar_t *, const wchar_t *, unsigned int);
SG_IMPORT SG_NORETURN void WINAPI ExitProcess(unsigned int);

extern const BYTE supergiga_payload[];
extern BYTE supergiga_destination[];

static const BYTE *sg_payload_address(void)
{
#if defined(__GNUC__)
    const BYTE *address;
    __asm__ volatile (
        "leaq supergiga_payload(%%rip), %0"
        : "=r" (address));
    return address;
#else
    return supergiga_payload;
#endif
}

static BYTE *sg_destination_address(void)
{
#if defined(__GNUC__)
    BYTE *address;
    __asm__ volatile (
        "leaq supergiga_destination(%%rip), %0"
        : "=r" (address));
    return address;
#else
    return supergiga_destination;
#endif
}

typedef int (WINAPI *SG_MESSAGE_BOX_W)(HWND, const wchar_t *, const wchar_t *, unsigned int);

typedef struct _SG_CARRIER_CONTEXT {
    DWORD version;
    SG_MESSAGE_BOX_W message_box_w;
} SG_CARRIER_CONTEXT;

typedef DWORD (SG_CDECL *SG_PAYLOAD_FN)(SG_CARRIER_CONTEXT *);
typedef DWORD (WINAPI *SG_THREAD_START)(PVOID);

static DWORD sg_carrier_run(void);

