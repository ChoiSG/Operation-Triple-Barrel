#if defined(__GNUC__)
#define SG_IMPORT __attribute__((dllimport))
#define SG_NORETURN __attribute__((noreturn))
#define SG_CDECL __attribute__((cdecl))
#define WINAPI __attribute__((stdcall))
#else
#define SG_IMPORT __declspec(dllimport)
#define SG_NORETURN __declspec(noreturn)
#define SG_CDECL __cdecl
#define WINAPI __stdcall
#endif
#define NULL ((void *)0)

SG_IMPORT PVOID WINAPI VirtualAlloc(PVOID, SIZE_T, DWORD, DWORD);
