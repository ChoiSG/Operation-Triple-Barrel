typedef unsigned short WORD;
typedef unsigned long DWORD;
typedef unsigned long long SIZE_T;
typedef unsigned long long ULONGLONG;
typedef signed long long LONGLONG;
typedef unsigned short wchar_t;
typedef int BOOL;
